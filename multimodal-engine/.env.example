# Google Gemini API key — required for transcription, scene analysis, blog synthesis, and clip verification
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_google_gemini_api_key_here"

# OpenAI API key — used as a fallback if Gemini scene analysis fails (optional but recommended)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"
